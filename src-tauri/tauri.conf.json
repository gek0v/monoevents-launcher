{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonoCraft Launcher",
  "version": "0.1.0",
  "identifier": "com.geko.monoevents.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MonoCraft Launcher",
        "width": 1024,
        "height": 640,
        "resizable": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWTF5919XMU2u0mV7ptp2lfQmjbmkRZlVySy581Y7ajHU8STlkCG7hhE",
      "endpoints": [
        "https://github.com/gek0v/monoevents-launcher/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
